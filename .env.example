# Copy to .env and fill in. NEVER commit .env.
# .env.example ships blank values on purpose.

# --- REQUIRED -------------------------------------------------------------
# 32-byte HMAC secret issued by the AgentGames dashboard when you register
# the agent (Dashboard -> agent -> Rotate Secret). Shown exactly once.
# The server refuses to start without it.
AGENT_GAMES_HMAC_SECRET=

# --- STRATEGY (Steal the VFY) ---------------------------------------------
# The committed strategy, as 8 comma-separated integers.
# The circuit enforces exactly this decision function:
#   if selfBalance < params[1]            -> FORTIFY
#   else if opponentBalance <= params[2]  -> HOLD  (inclusive, verified)
#   else                                  -> EXTRACT params[0]
#
# DEFAULT (safe): 1,0,1000,0,0,0,0,0  -> HOLD on every turn, always.
#   params[1]=0 means FORTIFY never triggers (balances are never < 0);
#   params[2]=1000 means HOLD always triggers (balances never exceed 1000
#   in a 20-turn match starting at 100);
#   params[0]=1 is the extract size, unused while HOLD triggers — and it
#   MUST be >= 1: the circuit rejects params[0] == 0 (assert line 90).
#   Verified locally against the real vfy-policy circuit (see
#   scripts/verify-fixture.js): HOLD proofs with these params verify,
#   and a wrong-action proof with these params FAILS at the circuit assert.
#
# TODO (YOUR DECISION): pick the real strategy BEFORE the next Swiss round
# pairs — the commitment is frozen mid-match and the platform rejects a
# circuitVersion / commitment that does not match the registered one.
# The published starter example is 8,18,8,0,0,0,0,0 (EXTRACT 8, unless
# self < 18 -> FORTIFY, or opponent <= 8 -> HOLD). That is an example of
# how the params map to behaviour, not a recommendation.
# After changing this, run `npm run commitment` and register the new hash
# on the dashboard (My Agents -> Edit agent -> Steal the VFY) BEFORE the
# round pairs. Do NOT change it mid-match.
STRATEGY_PARAMS=1,0,1000,0,0,0,0,0

# Private nonce for the Poseidon commitment. Generate one with:
#   npm run gen-salt
# Keep it secret (it is part of the commitment preimage). The commitment
# hash itself is public and is what you register on the dashboard.
STRATEGY_SALT=

# --- OPTIONAL -------------------------------------------------------------
# Port the server listens on (default 8787).
# PORT=8787

# Circuit version string sent in policyProof (default "1").
# The circuit itself does not enforce this; the PLATFORM checks it against
# your registered strategy commitment. Keep "1" unless the platform says
# otherwise.
# CIRCUIT_VERSION=1
